#!/usr/bin/env bash
set -e

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
cd "$DIR"

IMAGE_NAME="microbit-runner:latest"

function print_help() {
  echo "micro:bit Development & Testing CLI (Dockerized)"
  echo ""
  echo "Usage:"
  echo "  ./run build-image        Build or rebuild the Docker test image"
  echo "  ./run test [filter]      Run automated tests inside Docker (e.g., ./run test 01-blinking-heart)"
  echo "  ./run typecheck          Run TypeScript typecheck across all projects"
  echo "  ./run lint               Validate MakeCode Static TypeScript rules (no exports/imports)"
  echo "  ./run new <project_name> Scaffold a new project under projects/<project_name>"
  echo "Hardware & Firmware Commands:"
  echo "  ./run board              Detect USB-connected micro:bit board and port"
  echo "  ./run compile <proj>     Compile TypeScript to .hex inside Docker & cache in dist/<proj>/"
  echo "  ./run flash <proj>       Flash cached binary (dist/<proj>/latest.hex) to micro:bit"
  echo "  ./run cache <proj> [hex] Cache a .hex file with timestamp (YYYY-MM-DD_HHMM) in dist/"
  echo "  ./run rollback <hex>     Extract source code (.ts) from .hex into rollbacks/<proj>_<time>/"
  echo "  ./run monitor            Stream live serial output from connected micro:bit"
  echo ""
}

case "$1" in
  build-image)
    echo "🔨 Building Docker image: $IMAGE_NAME..."
    docker compose build test
    echo "✅ Docker image built successfully!"
    ;;

  test)
    shift
    FILTER="$1"
    if [ -n "$FILTER" ]; then
      echo "🧪 Running tests matching '$FILTER' in Docker..."
      docker compose run --rm test vitest run "$FILTER"
    else
      echo "🧪 Running all tests in Docker..."
      docker compose run --rm test vitest run
    fi
    ;;

  typecheck)
    echo "🔍 Running TypeScript typecheck in Docker..."
    docker compose run --rm typecheck
    ;;

  lint)
    echo "🔍 Validating MakeCode Static TypeScript compatibility across all projects..."
    docker compose run --rm test vitest run shared/tests/makecode-compatibility.test.ts
    ;;

  compile|build)
    shift
    PROJ="$1"
    if [ -z "$PROJ" ]; then
      echo "❌ Error: Project name required. Example: ./run compile 02-countdown-timer"
      exit 1
    fi
    echo "📦 Compiling '$PROJ' inside Docker..."
    docker compose run --rm test python3 scripts/compile_project.py "$PROJ"
    ;;

  shell)
    echo "🐚 Opening shell inside container..."
    docker compose run --rm test /bin/bash
    ;;

  board|detect)
    python3 scripts/board.py detect
    ;;

  flash)
    shift
    if [ -z "$1" ]; then
      echo "❌ Error: Project name or hex path required. Example: ./run flash 01-blinking-heart"
      exit 1
    fi
    python3 scripts/board.py flash "$1"
    ;;

  cache)
    shift
    PROJ="$1"
    HEX_PATH="$2"
    if [ -z "$PROJ" ]; then
      echo "❌ Error: Project name required. Example: ./run cache 01-blinking-heart [optional_hex_path]"
      exit 1
    fi
    # If no hex path given, check ~/Downloads/ for newest matching file
    if [ -z "$HEX_PATH" ]; then
      DOWNLOADED=$(find ~/Downloads -name "*${PROJ}*.hex" -o -name "microbit*.hex" 2>/dev/null | head -n 1)
      if [ -n "$DOWNLOADED" ]; then
        echo "🔍 Found downloaded hex file: $DOWNLOADED"
        HEX_PATH="$DOWNLOADED"
      else
        echo "❌ Error: No hex path provided and no matching file found in ~/Downloads."
        exit 1
      fi
    fi
    python3 scripts/board.py cache "$PROJ" "$HEX_PATH"
    ;;

  rollback|extract)
    shift
    HEX_PATH="$1"
    PROJ_NAME="$2"
    if [ -z "$HEX_PATH" ]; then
      echo "❌ Error: Path to .hex file required. Example: ./run rollback dist/01-blinking-heart/latest.hex"
      exit 1
    fi
    echo "🔄 Running hex rollback inside Docker..."
    docker compose run --rm test python3 scripts/hex_converter.py "$HEX_PATH" "$PROJ_NAME"
    ;;

  monitor)
    python3 scripts/board.py monitor
    ;;

  new)
    shift
    NAME="$1"
    if [ -z "$NAME" ]; then
      echo "❌ Error: Project name is required. Example: ./run new 02-digital-dice"
      exit 1
    fi
    TARGET_DIR="projects/$NAME"
    if [ -d "$TARGET_DIR" ]; then
      echo "❌ Error: Project '$TARGET_DIR' already exists."
      exit 1
    fi
    mkdir -p "$TARGET_DIR"

    # Create main.ts
    cat << 'EOF' > "$TARGET_DIR/main.ts"
// MakeCode TypeScript
// Paste this code into the 'JavaScript' tab at https://makecode.microbit.org/

function onButtonA() {
    basic.showString("A");
}

function onButtonB() {
    basic.showString("B");
}

input.onButtonPressed(Button.A, onButtonA);
input.onButtonPressed(Button.B, onButtonB);

basic.showIcon(IconNames.Heart);
EOF

    # Create main.test.ts
    cat << 'EOF' > "$TARGET_DIR/main.test.ts"
import { describe, it, expect, beforeEach, vi } from 'vitest';
import { microbit, Button } from '@shared/mocks/microbit';
import { validateMakeCodeFile } from '@shared/testing/makecode-validator';

describe('Project Logic', () => {
    beforeEach(async () => {
        microbit.reset();
        vi.resetModules();
        await import('./main');
    });

    it('is valid MakeCode TypeScript (no top-level exports or imports)', () => {
        const result = validateMakeCodeFile(new URL('./main.ts', import.meta.url).pathname);
        expect(result.errors).toEqual([]);
        expect(result.valid).toBe(true);
    });

    it('handles button A press', () => {
        microbit.input.pressButton(Button.A);
        expect(microbit.basic.lastString).toBe('A');
    });

    it('handles button B press', () => {
        microbit.input.pressButton(Button.B);
        expect(microbit.basic.lastString).toBe('B');
    });
});
EOF

    # Create README.md
    cat << EOF > "$TARGET_DIR/README.md"
# $NAME

## Description
A micro:bit project built with MakeCode TypeScript.

## How to Test
Run locally via Docker:
\`\`\`bash
./run test $NAME
\`\`\`

## How to Run in MakeCode Simulator
1. Open [makecode.microbit.org](https://makecode.microbit.org/)
2. Switch to the **JavaScript** tab.
3. Paste the contents of \`main.ts\`.
4. Observe the interactive simulator!
EOF

    echo "✨ Successfully scaffolded project at $TARGET_DIR"
    echo "   - $TARGET_DIR/main.ts"
    echo "   - $TARGET_DIR/main.test.ts"
    echo "   - $TARGET_DIR/README.md"
    ;;

  help|--help|-h|"")
    print_help
    ;;

  *)
    echo "Unknown command: $1"
    print_help
    exit 1
    ;;
esac
